    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "hono": "^4.13.16",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "aws-cdk": "^2.1147.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tsx": "^4.23.15",
